+
+struct IPadEndpoint: Equatable, Sendable {
+    let address: String
+    let port: UInt16
+}
+
+/// Find the paired iPad at its current IPv4 address and advertised port. The
+/// device's identity is checked again after the trusted tunnel opens.
+private final class IPadDiscovery: NSObject, NetServiceBrowserDelegate, NetServiceDelegate {
+    private let peer: RememberedIPad
+    private let browser = NetServiceBrowser()
+    private var resolving: [NetService] = []
+    private var completion: (([IPadEndpoint]) -> Void)?
+
+    init(peer: RememberedIPad) { self.peer = peer }
+
+    @MainActor
+    static func find(_ peer: RememberedIPad) async -> [IPadEndpoint] {
+        let discovery = IPadDiscovery(peer: peer)
+        return await withTaskCancellationHandler {
+            await withCheckedContinuation { continuation in
+                guard !Task.isCancelled else { continuation.resume(returning: []); return }
+                discovery.start { continuation.resume(returning: $0) }
+            }
+        } onCancel: {
+            DispatchQueue.main.async { discovery.finish([]) }
+        }
+    }
+
+    private func start(_ completion: @escaping ([IPadEndpoint]) -> Void) {
+        self.completion = completion
+        browser.delegate = self
+        browser.remove(from: .main, forMode: .default)
+        browser.schedule(in: .main, forMode: .common)
+        browser.searchForServices(ofType: "_remotepairing._tcp.", inDomain: "local.")
+        DispatchQueue.main.asyncAfter(deadline: .now() + 3) { [weak self] in self?.finish([]) }
+    }
+
+    private func finish(_ endpoints: [IPadEndpoint]) {
+        guard let completion else { return }
+        self.completion = nil
+        browser.delegate = nil
+        browser.stop()
+        for service in resolving {
+            service.delegate = nil
+            service.stopMonitoring()
+            service.stop()
+        }
+        resolving.removeAll()
+        completion(endpoints)
+    }
+
+    func netServiceBrowser(_ browser: NetServiceBrowser, didFind service: NetService, moreComing: Bool) {
+        resolving.append(service)
+        service.delegate = self
+        service.remove(from: .main, forMode: .default)
+        service.schedule(in: .main, forMode: .common)
+        service.resolve(withTimeout: 2)
+    }
+
+    func netServiceBrowser(_ browser: NetServiceBrowser, didNotSearch errorDict: [String: NSNumber]) {
+        finish([])
+    }
+
+    func netServiceDidResolveAddress(_ service: NetService) {
+        if let data = service.txtRecordData() { resolve(service, withTXTRecord: data) }
+        if completion != nil { service.startMonitoring() }
+    }
+
+    func netService(_ service: NetService, didUpdateTXTRecord data: Data) {
+        resolve(service, withTXTRecord: data)
+    }
+
+    private func resolve(_ service: NetService, withTXTRecord data: Data) {
+        guard let port = UInt16(exactly: service.port), port != 0 else { return }
+        let txt = NetService.dictionary(fromTXTRecord: data)
+        let record = Dictionary(txt.map { ($0.key.lowercased(), $0.value) }, uniquingKeysWith: { first, _ in first })
+        guard let identifier = record["identifier"].flatMap({ String(data: $0, encoding: .utf8) }),
+              let tag = record["authtag"].flatMap({ String(data: $0, encoding: .utf8) }),
+              peer.matches(identifier: identifier, tag: tag) else { return }
+        let endpoints: [IPadEndpoint] = (service.addresses ?? []).compactMap { data in
+            data.withUnsafeBytes { raw in
+                guard let base = raw.baseAddress, raw.count >= MemoryLayout<sockaddr_in>.size else { return nil }
+                let socket = base.assumingMemoryBound(to: sockaddr.self)
+                guard Int32(socket.pointee.sa_family) == AF_INET,
+                      let host = NetworkStatus.numericHost(socket, length: socklen_t(raw.count)),
+                      NetworkStatus.isOnWiFiSubnet(host), !NetworkStatus.isOwnAddress(host) else { return nil }
+                return IPadEndpoint(address: host, port: port)
+            }
+        }
+        if !endpoints.isEmpty { finish(endpoints) }
+    }
+}
+
+extension RememberedIPad {
+    @MainActor
+    func discover() async -> [IPadEndpoint] { await IPadDiscovery.find(self) }
+}
