@@ -0,0 +1,37 @@
+import Foundation
+import Testing
+@testable import SideInstaller
+
+struct RememberedIPadTests {
+    @Test func recordSurvivesReloadAndAddressChange() throws {
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let source = folder.appendingPathComponent("pair.plist")
+        let saved = folder.appendingPathComponent("ipad.plist")
+        let key = try #require(Data(base64Encoded: "Mgp6ZGPzXM2ku9br46vsiw=="))
+        let raw: [String: Any] = [
+            "private_key": Data(repeating: 1, count: 32),
+            "public_key": Data(repeating: 2, count: 32),
+            "identifier": "test-host",
+            "alt_irk": key,
+        ]
+        try PropertyListSerialization.data(fromPropertyList: raw, format: .xml, options: 0).write(to: source)
+        _ = try RememberedIPad.save(record: source, to: saved, udid: "test-udid",
+                                    name: "Test iPad", address: "192.168.1.10")
+        try FileManager.default.removeItem(at: source)
+        let first = try RememberedIPad.read(from: saved)
+        #expect(first.address == "192.168.1.10")
+        #expect(first.udid == "test-udid")
+        #expect(first.matches(identifier: "2BE6E510-0325-4365-923E-B14C6F57DB3A", tag: "kXjlTr2l"))
+        #expect(!first.matches(identifier: "2BE6E510-0325-4365-923E-B14C6F57DB3A", tag: "kXjlTr2m"))
+        _ = try RememberedIPad.save(record: saved, to: saved, udid: first.udid,
+                                    name: first.name, address: "192.168.1.20", port: 49153)
+        let moved = try RememberedIPad.read(from: saved)
+        #expect(moved.address == "192.168.1.20")
+        #expect(moved.port == 49153)
+        #expect(moved.udid == first.udid)
+        #expect(moved.discoveryKey == key)
+        #expect(PairingFileKind.of(path: saved.path).hasRemotePairing)
+    }
+}
