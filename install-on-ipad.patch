diff --git a/ios-app/PersonalIPadView.swift b/ios-app/PersonalIPadView.swift
new file mode 100644
index 0000000..106fc2d
--- /dev/null
+++ b/ios-app/PersonalIPadView.swift
@@ -0,0 +1,265 @@
+import SwiftUI
+
+struct PersonalIPadView: View {
+    @Environment(Engine.self) private var engine
+    @EnvironmentObject private var accounts: AccountStore
+    @StateObject private var manager = SideBySideManager(personalIPadMode: true)
+    @State private var pickingIPA = false
+    @State private var confirmingForget = false
+    @State private var removingRefreshCopy: IPadRefreshApp?
+    @State private var editingAccount: AccountEditorTarget?
+    @State private var shownTwoFactor: TwoFactorPhase?
+
+    var body: some View {
+        NavigationStack {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 20) {
+                    targetCard
+                    if manager.isRunning {
+                        progressCard
+                        if manager.pairingInSettings { pairingCard }
+                    } else if manager.finished {
+                        successCard
+                    } else {
+                        installControls
+                    }
+                    if !manager.isRunning && !manager.appsForRememberedIPad.isEmpty {
+                        refreshControls
+                    }
+                    if let notice = manager.refreshNotice {
+                        Label(notice, systemImage: "exclamationmark.circle")
+                            .foregroundStyle(Theme.warning)
+                    }
+                }
+                .padding(20)
+                .pageColumn()
+            }
+            .background(AppBackground())
+            .navigationTitle("Install on iPad")
+            .navigationBarTitleDisplayMode(.inline)
+        }
+        .sheet(isPresented: $pickingIPA) {
+            FileImporterRepresentableView(allowedContentTypes: [.ipa]) { urls in
+                guard let url = urls.first else { return }
+                importIPA(url)
+            }
+            .ignoresSafeArea()
+        }
+        .sheet(item: $editingAccount) { target in
+            AccountEditor(target: target, isPersonalIPadBuild: true)
+        }
+        .sheet(isPresented: Binding(
+            get: { engine.twoFactor != nil },
+            set: { if !$0, let phase = engine.twoFactor { engine.cancelTwoFactor(phase) } }
+        )) {
+            if let phase = engine.twoFactor ?? shownTwoFactor {
+                TwoFactorSheet(phase: phase)
+            }
+        }
+        .onChange(of: engine.twoFactor) { _, phase in
+            if let phase { shownTwoFactor = phase }
+        }
+        .onChange(of: accounts.revision) { _, _ in manager.signOut() }
+        .onOpenURL { url in
+            guard url.isFileURL, url.pathExtension.lowercased() == "ipa" else { return }
+            importIPA(url)
+        }
+        .alert("Forget this iPad?", isPresented: $confirmingForget) {
+            Button("Forget iPad", role: .destructive) { manager.forgetIPad() }
+            Button("Cancel", role: .cancel) {}
+        } message: {
+            Text("You’ll approve a new pairing on the iPad before the next install.")
+        }
+        .alert("Remove saved IPA?", isPresented: Binding(
+            get: { removingRefreshCopy != nil },
+            set: { if !$0 { removingRefreshCopy = nil } }
+        ), presenting: removingRefreshCopy) { app in
+            Button("Remove Saved IPA", role: .destructive) {
+                manager.removeIPadRefreshCopy(app)
+                removingRefreshCopy = nil
+            }
+            Button("Cancel", role: .cancel) {}
+        } message: { app in
+            Text("This frees up space on the iPhone. To refresh \(app.name) later, choose its IPA and install it again.")
+        }
+    }
+
+    private func importIPA(_ url: URL) {
+        guard !manager.isRunning else { return }
+        manager.prepareAnotherIPadInstall()
+        Task { await manager.importCustomIPA(from: url) }
+    }
+
+    private var targetCard: some View {
+        PanelCard {
+            VStack(alignment: .leading, spacing: 10) {
+                Label(manager.rememberedIPad?.name ?? "Pair your iPad", systemImage: "ipad")
+                    .font(.headline)
+                if manager.rememberedIPad != nil {
+                    Text("Pairing saved")
+                        .foregroundStyle(.secondary)
+                    if !manager.isRunning {
+                        Button("Forget iPad", role: .destructive) { confirmingForget = true }
+                    }
+                } else {
+                    Text("Keep both devices on the same Wi-Fi and turn on Developer Mode on the iPad. You’ll approve a pairing code during the first install.")
+                        .foregroundStyle(.secondary)
+                }
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+    }
+
+    private var installControls: some View {
+        VStack(alignment: .leading, spacing: 14) {
+            Button {
+                pickingIPA = true
+            } label: {
+                Label(manager.customIPA.map { $0.file.lastPathComponent } ?? "Choose IPA",
+                      systemImage: "doc.zipper")
+                    .lineLimit(1)
+                    .truncationMode(.middle)
+            }
+            .buttonStyle(SecondaryButtonStyle())
+            .disabled(manager.isImportingIPA)
+
+            Button {
+                editingAccount = accounts.active.map(AccountEditorTarget.existing) ?? .new
+            } label: {
+                Label(accounts.active?.normalized ?? "Add signing Apple Account", systemImage: "person.crop.circle")
+            }
+            .buttonStyle(SecondaryButtonStyle())
+
+            if manager.customIPA != nil {
+                Toggle("Request Increased Memory Limit", isOn: $manager.requestIncreasedMemory)
+            }
+
+            if manager.isImportingIPA { ProgressView("Importing IPA…") }
+            if let message = manager.lastError ?? manager.importError {
+                Label(message, systemImage: "exclamationmark.circle")
+                    .foregroundStyle(Theme.warning)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+
+            Button("Install on iPad") { manager.start() }
+                .buttonStyle(PrimaryButtonStyle())
+                .disabled(manager.customIPA == nil || manager.isImportingIPA || !manager.hasCredentials)
+        }
+    }
+
+    private var refreshControls: some View {
+        PanelCard {
+            VStack(alignment: .leading, spacing: 12) {
+                Text("Refresh iPad apps").font(.headline)
+                ForEach(manager.appsForRememberedIPad) { app in
+                    ViewThatFits(in: .horizontal) {
+                        HStack {
+                            refreshDetails(app)
+                            Spacer(minLength: 12)
+                            refreshActions(app)
+                        }
+                        VStack(alignment: .leading, spacing: 8) {
+                            refreshDetails(app)
+                            refreshActions(app)
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private func refreshDetails(_ app: IPadRefreshApp) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            Text(app.name).font(.subheadline.weight(.medium))
+            if let date = app.expirationDate {
+                Text(date <= Date() ? "Expired \(date.formatted(date: .abbreviated, time: .shortened))"
+                     : "Expires \(date.formatted(date: .abbreviated, time: .shortened))")
+                    .font(.caption).foregroundStyle(.secondary)
+            }
+            if app.increasedMemory {
+                Text("Increased Memory Limit").font(.caption).foregroundStyle(.secondary)
+            }
+        }
+    }
+
+    private func refreshActions(_ app: IPadRefreshApp) -> some View {
+        HStack(spacing: 8) {
+            Button { manager.start(refreshing: app) } label: {
+                Label("Refresh", systemImage: "arrow.clockwise").fixedSize()
+            }
+            .buttonStyle(.bordered)
+            .disabled(!manager.hasCredentials || manager.isImportingIPA)
+            .accessibilityLabel("Refresh \(app.name)")
+
+            Menu {
+                if !app.increasedMemory {
+                    Button("Refresh with Increased Memory Limit") {
+                        manager.start(refreshing: app, requiringIncreasedMemory: true)
+                    }
+                    .disabled(!manager.hasCredentials || manager.isImportingIPA)
+                }
+                Button("Remove Saved IPA", role: .destructive) { removingRefreshCopy = app }
+            } label: {
+                Image(systemName: "ellipsis.circle").padding(6)
+            }
+            .accessibilityLabel("Options for \(app.name)")
+        }
+    }
+
+    private var progressCard: some View {
+        PanelCard {
+            VStack(alignment: .leading, spacing: 12) {
+                ProgressView(value: manager.overallProgress) {
+                    Text(manager.isCancelling ? "Cancelling…"
+                         : manager.refreshingIPadApp ? "Refreshing \(manager.runName)" : "Installing \(manager.runName)")
+                }
+                if let step = manager.runSteps.first(where: {
+                    manager.stepStates[$0] == .active || manager.stepStates[$0] == .waiting
+                }) {
+                    Text(step == .connect ? "Connecting to your iPad"
+                         : step == .install ? "Sending the app to your iPad"
+                         : step.title(for: manager.runApp))
+                        .foregroundStyle(.secondary)
+                }
+                Button("Cancel", role: .cancel) { manager.cancel() }
+                    .disabled(manager.isCancelling)
+            }
+        }
+    }
+
+    private var pairingCard: some View {
+        PanelCard {
+            VStack(alignment: .leading, spacing: 12) {
+                Text("Approve pairing on your iPad").font(.headline)
+                Text("Open Settings → Privacy & Security → Developer Mode. Tap ‘Pair with \(PairingController.peerHostName)’ and enter the code shown here.")
+                    .foregroundStyle(.secondary)
+                if let pin = manager.pairingPIN {
+                    PairingCodeDigits(pin: pin)
+                }
+            }
+        }
+    }
+
+    private var successCard: some View {
+        let name = manager.installedAppName ?? manager.runName
+        return PanelCard {
+            VStack(alignment: .leading, spacing: 12) {
+                Label(manager.refreshingIPadApp ? "\(name) refreshed" : "\(name) installed",
+                      systemImage: "checkmark.circle")
+                    .font(.headline)
+                if manager.installedWithIncreasedMemory == true {
+                    Text("Increased Memory Limit granted").foregroundStyle(.secondary)
+                }
+                if !manager.refreshingIPadApp {
+                    Text("If iPadOS asks you to trust the signing account, open Settings → General → VPN & Device Management on the iPad.")
+                        .foregroundStyle(.secondary)
+                }
+                Button("Install another IPA") {
+                    manager.prepareAnotherIPadInstall()
+                    pickingIPA = true
+                }
+                .buttonStyle(PrimaryButtonStyle())
+            }
+        }
+    }
+}
diff --git a/ios-app/RememberedIPad.swift b/ios-app/RememberedIPad.swift
new file mode 100644
index 0000000..4a44c5c
--- /dev/null
+++ b/ios-app/RememberedIPad.swift
@@ -0,0 +1,158 @@
+import Darwin
+import Foundation
+import SideInstallerFFI
+
+/// A single explicitly approved target. Keep metadata in the same atomic
+/// write as the Remote Pairing record so an interrupted save cannot mix peers.
+struct RememberedIPad {
+    let udid: String
+    let name: String
+    let address: String
+    let port: UInt16
+    let discoveryKey: Data
+
+    private static let metadataKey = "SideInstallerRememberedIPad"
+
+    static func read(from file: URL = PrivateStore.rememberedIPadPairing) throws -> Self {
+        let plist = try dictionary(at: file)
+        guard let metadata = plist[metadataKey] as? [String: String],
+              let udid = metadata["udid"], !udid.isEmpty,
+              let name = metadata["name"], let address = metadata["address"],
+              let key = plist["alt_irk"] as? Data, key.count == 16 else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        let port = metadata["port"].flatMap { UInt16($0) } ?? DeviceConnection.rsdPort
+        guard port > 0 else { throw CocoaError(.fileReadCorruptFile) }
+        return Self(udid: udid, name: name, address: address, port: port, discoveryKey: key)
+    }
+
+    static func save(record: URL, to file: URL = PrivateStore.rememberedIPadPairing,
+                     udid: String, name: String, address: String,
+                     port: UInt16 = DeviceConnection.rsdPort) throws -> Self {
+        var plist = try dictionary(at: record)
+        guard !udid.isEmpty, port > 0, let key = plist["alt_irk"] as? Data, key.count == 16 else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        plist[metadataKey] = ["udid": udid, "name": name, "address": address, "port": String(port)]
+        let data = try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)
