+++ b/ios-tests/IPadRefreshStoreTests.swift
@@ -0,0 +1,42 @@
+import Foundation
+import Testing
+@testable import SideInstaller
+
+struct IPadRefreshStoreTests {
+    @Test func refreshKeepsOriginalIPAAndUpdatesProfile() throws {
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let store = IPadRefreshStore(directory: folder.appendingPathComponent("refresh"))
+        let original = folder.appendingPathComponent("original.ipa")
+        let payload = Data("test IPA".utf8)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        try payload.write(to: original)
+        #expect(try store.load().isEmpty)
+
+        let id = UUID()
+        let initial = entry(id: id, memory: false, expiry: 100)
+        _ = try store.save(initial, originalIPA: original)
+        try FileManager.default.removeItem(at: original)
+
+        let renewed = entry(id: id, memory: true, expiry: 200)
+        _ = try store.save(renewed, originalIPA: nil)
+        #expect(try store.load() == [renewed])
+        #expect(try Data(contentsOf: store.archive(for: renewed)) == payload)
+
+        let missing = folder.appendingPathComponent("missing.ipa")
+        #expect(throws: (any Error).self) { try store.save(entry(id: UUID(), memory: false, expiry: 300), originalIPA: missing) }
+        #expect(try store.load() == [renewed])
+        #expect(FileManager.default.fileExists(atPath: store.archive(for: renewed).path))
+
+        let remaining = try store.remove(renewed)
+        #expect(remaining.isEmpty)
+        #expect(!FileManager.default.fileExists(atPath: store.archive(for: renewed).path))
+    }
+
+    private func entry(id: UUID, memory: Bool, expiry: TimeInterval) -> IPadRefreshApp {
+        IPadRefreshApp(archiveID: id, deviceID: "iPad", applicationID: "TEAM.com.example.app.TEAM",
+                       bundleID: "com.example.app.TEAM", appleID: "test@example.com", name: "Example",
+                       version: "1.0", increasedMemory: memory,
+                       expirationDate: Date(timeIntervalSince1970: expiry))
+    }
+}
