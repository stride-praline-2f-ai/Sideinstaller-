 }
 
+/// Match a Remote Pairing Bonjour advertisement against the paired device's key.
+///
+/// # Safety
+/// `key` must point to 16 readable bytes. The other pointers must be valid
+/// NUL-terminated C strings, or null.
+#[no_mangle]
+pub unsafe extern "C" fn si_pairing_matches_advert(
+    key: *const u8,
+    identifier: *const c_char,
+    auth_tag: *const c_char,
+) -> bool {
+    if key.is_null() {
+        return false;
+    }
+    let (Some(identifier), Some(auth_tag)) =
+        (ffi_util::req_str(identifier), ffi_util::req_str(auth_tag))
+    else {
+        return false;
+    };
+    idevice::remote_pairing::PeerDevice::validate_auth_tag(
+        std::slice::from_raw_parts(key, 16),
+        &identifier,
+        &auth_tag,
+    )
+}
+
