diff --git a/ios-app/IPadRefreshStore.swift b/ios-app/IPadRefreshStore.swift
new file mode 100644
index 0000000..218534e
--- /dev/null
+++ b/ios-app/IPadRefreshStore.swift
@@ -0,0 +1,73 @@
+import Foundation
+
+struct IPadRefreshApp: Codable, Identifiable, Equatable {
+    let archiveID: UUID
+    let deviceID: String
+    let applicationID: String
+    let bundleID: String
+    let appleID: String
+    let name: String
+    let version: String?
+    let increasedMemory: Bool
+    let expirationDate: Date?
+
+    var id: UUID { archiveID }
+}
+
+/// Keeps the original IPA so signing again produces the same bundle identity.
+/// A new archive is committed to the index before its predecessor is removed.
+struct IPadRefreshStore {
+    static let memoryEntitlement = "com.apple.developer.kernel.increased-memory-limit"
+    var directory: URL = PrivateStore.iPadRefreshDirectory
+    private var index: URL { directory.appendingPathComponent("index.json") }
+
+    func archive(for app: IPadRefreshApp) -> URL {
+        directory.appendingPathComponent(app.archiveID.uuidString).appendingPathExtension("ipa")
+    }
+
+    func load() throws -> [IPadRefreshApp] {
+        do {
+            return try JSONDecoder().decode([IPadRefreshApp].self, from: Data(contentsOf: index))
+        } catch let error as CocoaError where error.code == .fileReadNoSuchFile {
+            return []
+        }
+    }
+
+    func save(_ app: IPadRefreshApp, originalIPA: URL?) throws -> [IPadRefreshApp] {
+        let previous = try load()
+        let matching = previous.filter {
+            $0.deviceID.caseInsensitiveCompare(app.deviceID) == .orderedSame && $0.applicationID == app.applicationID
+        }
+        let updated = [app] + previous.filter { !matching.contains($0) }
+        let disk = FileManager.default
+        try disk.createDirectory(at: directory, withIntermediateDirectories: true)
+        let destination = archive(for: app)
+        if let originalIPA {
+            // Stage a fresh archive out of sight of the index until the copy
+            // succeeds, so updates and failed transfers leave the old IPA intact.
+            let staging = directory.appendingPathComponent(UUID().uuidString + ".partial")
+            defer { try? disk.removeItem(at: staging) }
+            try disk.copyItem(at: originalIPA, to: staging)
+            try disk.moveItem(at: staging, to: destination)
+        }
+        do {
+            try JSONEncoder().encode(updated).write(to: index, options: .atomic)
+        } catch {
+            if originalIPA != nil { try? disk.removeItem(at: destination) }
+            throw error
+        }
+        // Removing previous copies after the index write also makes new installs
+        // over the same app use the most recently installed IPA on refresh.
+        for old in matching where old.archiveID != app.archiveID {
+            try? disk.removeItem(at: archive(for: old))
+        }
+        return updated
+    }
+
+    func remove(_ app: IPadRefreshApp) throws -> [IPadRefreshApp] {
+        let updated = try load().filter { $0.id != app.id }
+        try JSONEncoder().encode(updated).write(to: index, options: .atomic)
+        try? FileManager.default.removeItem(at: archive(for: app))
+        return updated
+    }
+}
